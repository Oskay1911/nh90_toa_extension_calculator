 items-center gap-2"><span class="text-blue-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg></span>Strategic Impact Analysis</h4><p class="text-slate-300 text-sm leading-relaxed mb-4">CRITICAL: Workload exceeds capacity by 400% during peak months.</p></div></section></main><footer class="max-w-7xl mx-auto mt-12 pt-8 border-t border-slate-200 text-slate-400 text-xs flex flex-col md:flex-row justify-between items-center gap-4"><div class="flex items-center gap-4"><span>GKN Fokker Aerospace B.V.</span><button class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg transition-colors font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>Copy Code for Saving</button></div><div>Author: Oskay Celikkol \'95 500846077</div></footer></div></div>\
\
    <!-- Hidden textarea for copying code -->\
    <textarea id="codeSource" style="display:none;"></textarea>\
\
    <script type="text/babel">\
        const \{ useState, useMemo \} = React;\
\
        // Simple Inline SVG Icons for stability\
        const Icons = \{\
            Calendar: () => (\
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>\
            ),\
            Users: () => (\
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>\
            ),\
            TrendingUp: () => (\
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>\
            ),\
            AlertTriangle: () => (\
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>\
            ),\
            DollarSign: () => (\
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>\
            ),\
            Clock: () => (\
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>\
            ),\
            Copy: () => (\
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>\
            )\
        \};\
\
        const App = () => \{\
            const RechartsLib = window.Recharts;\
            const [copied, setCopied] = useState(false);\
\
            if (!RechartsLib) \{\
                return (\
                    <div className="flex items-center justify-center min-h-screen">\
                        <div className="text-center p-8 bg-white rounded-xl shadow-lg">\
                            <h2 className="text-red-600 font-bold text-xl mb-2">Loading Error</h2>\
                            <p className="text-slate-600">The visualization library could not be loaded.</p>\
                        </div>\
                    </div>\
                );\
            \}\
\
            const \{ \
                BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer \
            \} = RechartsLib;\
\
            const [technicians, setTechnicians] = useState(12);\
            const [hoursPerMonth, setHoursPerMonth] = useState(150);\
            const [manHoursPerOverhaul, setManHoursPerOverhaul] = useState(450);\
            const [avgPartsCost, setAvgPartsCost] = useState(25000);\
            const [overtimePremium, setOvertimePremium] = useState(1.5);\
            const [hourlyRate, setHourlyRate] = useState(85);\
\
            const [schedule, setSchedule] = useState([\
                \{ month: 'Jan', units: 4 \}, \{ month: 'Feb', units: 3 \}, \{ month: 'Mar', units: 5 \},\
                \{ month: 'Apr', units: 4 \}, \{ month: 'May', units: 4 \}, \{ month: 'Jun', units: 3 \},\
                \{ month: 'Jul', units: 20 \}, \{ month: 'Aug', units: 18 \}, \{ month: 'Sep', units: 5 \},\
                \{ month: 'Oct', units: 4 \}, \{ month: 'Nov', units: 3 \}, \{ month: 'Dec', units: 4 \}\
            ]);\
\
            const totalAvailableHours = technicians * hoursPerMonth;\
\
            const calculatedData = useMemo(() => \{\
                return schedule.map(item => \{\
                    const requiredHours = item.units * manHoursPerOverhaul;\
                    const capacityGap = Math.max(0, requiredHours - totalAvailableHours);\
                    const overtimeCost = capacityGap * hourlyRate * overtimePremium;\
                    const utilization = totalAvailableHours > 0 ? (requiredHours / totalAvailableHours) * 100 : 0;\
                    const partsCost = item.units * avgPartsCost;\
                    \
                    return \{\
                        ...item,\
                        requiredHours,\
                        availableHours: totalAvailableHours,\
                        capacityGap,\
                        overtimeCost,\
                        utilization: Math.round(utilization),\
                        partsCost,\
                        totalFinancialImpact: overtimeCost + partsCost\
                    \};\
                \});\
            \}, [schedule, totalAvailableHours, manHoursPerOverhaul, hourlyRate, overtimePremium, avgPartsCost]);\
\
            const totalOvertimeCost = calculatedData.reduce((acc, curr) => acc + curr.overtimeCost, 0);\
            const maxUtilization = Math.max(...calculatedData.map(d => d.utilization));\
            const totalUnits = schedule.reduce((acc, curr) => acc + curr.units, 0);\
\
            const handleUnitChange = (index, value) => \{\
                const val = parseInt(value);\
                const newSchedule = [...schedule];\
                newSchedule[index].units = isNaN(val) ? 0 : val;\
                setSchedule(newSchedule);\
            \};\
\
            const handleCopyCode = () => \{\
                const code = document.documentElement.outerHTML;\
                const textArea = document.createElement("textarea");\
                textArea.value = code;\
                document.body.appendChild(textArea);\
                textArea.select();\
                try \{\
                    document.execCommand('copy');\
                    setCopied(true);\
                    setTimeout(() => setCopied(false), 2000);\
                \} catch (err) \{\
                    console.error('Fallback: Oops, unable to copy', err);\
                \}\
                document.body.removeChild(textArea);\
            \};\
\
            return (\
                <div className="min-h-screen p-4 md:p-8 text-slate-900">\
                    <header className="max-w-7xl mx-auto mb-8">\
                        <div className="flex items-center gap-3 mb-2 text-blue-800">\
                            <span className="text-blue-600"><Icons.Calendar /></span>\
                            <h1 className="text-2xl md:text-3xl font-bold tracking-tight">NH90 TOA Extension Impact Calculator</h1>\
                        </div>\
                        <p className="text-slate-500 max-w-2xl">\
                            Logistical and economical analysis tool for MRO capacity planning at GKN Fokker Aerospace.\
                        </p>\
                    </header>\
\
                    <main className="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8">\
                        <section className="lg:col-span-4 space-y-6">\
                            <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">\
                                <h2 className="flex items-center gap-2 font-semibold text-lg mb-4 text-slate-800">\
                                    <span className="text-blue-600"><Icons.Users /></span>\
                                    MRO Capacity Settings\
                                </h2>\
                                <div className="space-y-4">\
                                    <div>\
                                        <label className="block text-sm font-medium text-slate-600 mb-1 font-semibold">Available Technicians</label>\
                                        <input type="range" min="1" max="30" value=\{technicians\} onChange=\{(e) => setTechnicians(parseInt(e.target.value))\} className="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer" />\
                                        <div className="flex justify-between text-xs mt-1 font-mono text-blue-600 font-bold">\{technicians\} FTEs</div>\
                                    </div>\
                                    <div>\
                                        <label className="block text-sm font-medium text-slate-600 mb-1 font-semibold">Man-Hours per Overhaul</label>\
                                        <input type="number" value=\{manHoursPerOverhaul\} onChange=\{(e) => setManHoursPerOverhaul(parseInt(e.target.value) || 0)\} className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:border-blue-500 transition-colors" />\
                                    </div>\
                                    <div className="pt-4 border-t border-slate-100 flex justify-between items-center">\
                                        <span className="text-sm text-slate-600 font-medium">Total Hours/Month</span>\
                                        <span className="font-bold text-blue-600">\{totalAvailableHours\}h</span>\
                                    </div>\
                                </div>\
                            </div>\
\
                            <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">\
                                <h2 className="flex items-center gap-2 font-semibold text-lg mb-4 text-slate-800">\
                                    <span className="text-green-600"><Icons.TrendingUp /></span>\
                                    Scenario: 2026 Units\
                                </h2>\
                                <div className="grid grid-cols-3 gap-2">\
                                    \{schedule.map((item, idx) => (\
                                        <div key=\{item.month\}>\
                                            <label className="block text-[10px] uppercase font-bold text-slate-400">\{item.month\}</label>\
                                            <input type="number" value=\{item.units\} onChange=\{(e) => handleUnitChange(idx, e.target.value)\} className=\{`w-full p-2 text-center text-sm border rounded outline-none transition-colors $\{item.units > 10 ? 'bg-red-50 border-red-300 text-red-700 font-bold' : 'bg-slate-50 border-slate-200 focus:border-blue-400'\}`\} />\
                                        </div>\
                                    ))\}\
                                </div>\
                            </div>\
                        </section>\
\
                        <section className="lg:col-span-8 space-y-6">\
                            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">\
                                <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">\
                                    <div className="flex items-center gap-3 mb-3 text-red-500"><Icons.AlertTriangle /><span className="text-sm font-medium text-slate-500">Max Utilization</span></div>\
                                    <div className=\{`text-2xl font-bold $\{maxUtilization > 100 ? 'text-red-600' : 'text-slate-900'\}`\}>\{maxUtilization\}%</div>\
                                </div>\
                                <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">\
                                    <div className="flex items-center gap-3 mb-3 text-blue-600"><Icons.DollarSign /><span className="text-sm font-medium text-slate-500">Overtime Cost</span></div>\
                                    <div className="text-2xl font-bold">\'80\{totalOvertimeCost.toLocaleString()\}</div>\
                                </div>\
                                <div className="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">\
                                    <div className="flex items-center gap-3 mb-3 text-slate-600"><Icons.Clock /><span className="text-sm font-medium text-slate-500">Total Units</span></div>\
                                    <div className="text-2xl font-bold">\{totalUnits\}</div>\
                                </div>\
                            </div>\
\
                            <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">\
                                <h3 className="font-bold text-slate-800 mb-6">Workload vs Capacity Analysis</h3>\
                                <div className="h-80 w-full" style=\{\{ minHeight: '320px' \}\}>\
                                    <ResponsiveContainer width="100%" height="100%">\
                                        <BarChart data=\{calculatedData\} margin=\{\{ top: 10, right: 10, left: 0, bottom: 0 \}\}>\
                                            <CartesianGrid strokeDasharray="3 3" vertical=\{false\} stroke="#f1f5f9" />\
                                            <XAxis dataKey="month" axisLine=\{false\} tickLine=\{false\} tick=\{\{fill: '#94a3b8', fontSize: 12\}\} />\
                                            <YAxis axisLine=\{false\} tickLine=\{false\} tick=\{\{fill: '#94a3b8', fontSize: 12\}\} />\
                                            <Tooltip contentStyle=\{\{ borderRadius: '8px', border: 'none', boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)' \}\} />\
                                            <Legend verticalAlign="top" align="right" wrapperStyle=\{\{ paddingBottom: '20px' \}\} />\
                                            <Bar dataKey="requiredHours" name="Required Hours" fill="#3b82f6" radius=\{[4, 4, 0, 0]\} />\
                                            <Bar dataKey="availableHours" name="Standard Capacity" fill="#e2e8f0" radius=\{[4, 4, 0, 0]\} />\
                                        </BarChart>\
                                    </ResponsiveContainer>\
                                </div>\
                            </div>\
\
                            <div className="bg-slate-900 text-white p-8 rounded-2xl shadow-lg border border-slate-800">\
                                <h4 className="text-xl font-bold mb-3 flex items-center gap-2"><span className="text-blue-400"><Icons.TrendingUp /></span>Strategic Impact Analysis</h4>\
                                <p className="text-slate-300 text-sm leading-relaxed mb-4">\
                                    \{maxUtilization > 120 ? `CRITICAL: Workload exceeds capacity by $\{maxUtilization - 100\}% during peak months.` : "The current maintenance schedule is within manageable limits."\}\
                                </p>\
                            </div>\
                        </section>\
                    </main>\
\
                    <footer className="max-w-7xl mx-auto mt-12 pt-8 border-t border-slate-200 text-slate-400 text-xs flex flex-col md:flex-row justify-between items-center gap-4">\
                        <div className="flex items-center gap-4">\
                            <span>GKN Fokker Aerospace B.V.</span>\
                            <button \
                                onClick=\{handleCopyCode\}\
                                className="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg transition-colors font-medium"\
                            >\
                                <Icons.Copy />\
                                \{copied ? 'Code Copied!' : 'Copy Code for Saving'\}\
                            </button>\
                        </div>\
                        <div>Author: Oskay Celikkol \'95 500846077</div>\
                    </footer>\
                </div>\
            );\
        \};\
\
        const root = ReactDOM.createRoot(document.getElementById('root'));\
        root.render(<App />);\
    </script>\
\
